<Window x:Name="SettingsWindow" x:Class="Quicklaunch.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quicklaunch"
        mc:Ignorable="d"
        Title="Settings"  Width="Auto" Height="211" SizeToContent="WidthAndHeight" Loaded="SettingsWindow_Loaded" Padding="0,0,0,0">
    <Window.Foreground>
        <ImageBrush/>
    </Window.Foreground>
    <Grid x:Name="SettingsGrid" Margin="0,0,0,10">

        <Grid.RowDefinitions>
            <RowDefinition MinHeight="50" Height="Auto"/>
            <RowDefinition MinHeight="50" Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical"  Grid.Row="0" Grid.Column="0">

            <Label x:Name="label" Content="Folder containing links" Grid.Column="0" Grid.Row="0" Margin="0,0,0,0" FontSize="10" VerticalAlignment="Top"  Padding="0,2,0,0" HorizontalContentAlignment="Right" HorizontalAlignment="Left"/>
            <TextBox x:Name="folder" TextWrapping="WrapWithOverflow" Text="" Margin="0,0,0,0" />
        </StackPanel>
        <Button x:Name="ok" Grid.Column="1" Content="Ok" HorizontalAlignment="Left" Grid.Row="3" Width="34" VerticalAlignment="Bottom" Click="ok_Click" Height="20" Margin="10,0,0,0"/>
        <GroupBox x:Name="OnTop" Header="Always on top" Grid.Row="1" Height="40" Grid.Column="0" Foreground="Black" HorizontalAlignment="Left"  >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <RadioButton x:Name="onTopYes" GroupName="OnTop" Content="yes" HorizontalAlignment="Left" Margin="0,0,0,1" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="36"/>
                <RadioButton x:Name="onTopNo" GroupName="OnTop" Content="no" HorizontalAlignment="Left" Margin="5,0,0,0" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="39" Checked="onTopNo_Checked"/>

            </StackPanel>
        </GroupBox>

        <Button x:Name="cancel" Grid.Column="1" Width="50px" Grid.Row="3" Content="Cancel"  Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,5,0"/>
        <Button x:Name="browse" Content="Browse" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Width="50" Click="button_Click" Height="20" Margin="0,8,0,0">

        </Button>
        <GroupBox x:Name="orientation" Header="Orientation" Grid.Column="0" Grid.Row="2" Height="50" VerticalAlignment="Top" Foreground="Black">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="orientationHorizontal" GroupName="Orientation" Content="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,1" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="80"/>
                <RadioButton x:Name="orientationVertical" GroupName="Orientation" Content="Vertical" HorizontalAlignment="Left" Margin="5,0,0,0" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="80"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
