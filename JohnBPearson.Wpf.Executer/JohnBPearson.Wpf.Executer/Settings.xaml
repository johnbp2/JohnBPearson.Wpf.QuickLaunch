<Window x:Name="SettingsWindow" x:Class="Quicklaunch.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quicklaunch"
        mc:Ignorable="d"
        Title="Settings"  Width="Auto" Height="Auto" SizeToContent="WidthAndHeight" Loaded="SettingsWindow_Loaded" >
    <Window.Foreground>
        <ImageBrush/>
    </Window.Foreground>

    <StackPanel Orientation="Vertical">

    <GroupBox x:Name="gbFolder" Header="Toolbar folder"  Foreground="Black" BorderBrush="Black" >
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="folder" TextWrapping="WrapWithOverflow"  Text="" BorderBrush="#FF737780" Width="180" />
                <!--<Label x:Name="label" Content="Selected Dir." Grid.Column="0" Grid.Row="0" Margin="0,0,0,0" FontSize="10" VerticalAlignment="Top" Height="18" Width="53" Padding="0,2,0,0" HorizontalContentAlignment="Right" HorizontalAlignment="Left"/>-->
                <Button x:Name="browse" Content="Browse" Width="50" Click="button_Click" Height="20" Margin="5,8,0,0"/>
            </StackPanel>
            </GroupBox>

        <GroupBox x:Name="gbOnTop" Header="Always on top" Foreground="Black"  BorderBrush="Black" >
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="onTopYes" GroupName="OnTop" Content="yes" HorizontalAlignment="Left" Margin="0,20,0,1" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="36"/>
                <RadioButton x:Name="onTopNo" GroupName="OnTop" Content="no" HorizontalAlignment="Left" Margin="5,20,0,0" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="39" Checked="onTopNo_Checked"/>

            </StackPanel>
        </GroupBox>




        <GroupBox x:Name="orientation" Header="Orientation"  Foreground="Black"  BorderBrush="Black">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="orientationHorizontal" GroupName="Orientation" Content="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,1" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="80"/>
                <RadioButton x:Name="orientationVertical" GroupName="Orientation" Content="Vertical" HorizontalAlignment="Left" Margin="5,20,0,0" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="80"/>
            </StackPanel>
        </GroupBox>


        <GroupBox x:Name="opacitry" Header="Opacity" Foreground="Black"  BorderBrush="Black">
            <StackPanel Orientation="Horizontal">

            <Slider x:Name="opacitySlider" Minimum="1" Maximum="100" IsSnapToTickEnabled="True" HorizontalAlignment="Left" Margin="0,0,0,0" Width="150" LargeChange="5" SmallChange="1" ValueChanged="opacitySlider_ValueChanged"/>
                <Label x:Name="labelOpacity" Grid.Column="1" Content="0" HorizontalAlignment="Left" Margin="25,0,0,0" Grid.Row="3" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button x:Name="cancel"  Width="50px" Grid.Row="4" Content="Cancel" HorizontalAlignment="Right" Height="20" Click="cancel_Click"  Margin="5,5,5,5"/>
            <Button x:Name="ok" Content="Ok" Width="34" Click="ok_Click" HorizontalAlignment="Right" Height="20" Margin="0,5,5,5"/>

        </StackPanel>
        
    </StackPanel>
</Window>
