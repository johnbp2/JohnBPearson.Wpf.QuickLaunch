<Window x:Name="SettingsWindow" x:Class="Quicklaunch.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quicklaunch.Controls"
        mc:Ignorable="d"
        Title="Settings"  Width="Auto" Height="Auto" SizeToContent="WidthAndHeight" Loaded="SettingsWindow_Loaded" >


    <StackPanel x:Name="mainStackPanel" Orientation="Vertical">
        <local:FolderDialog x:Name="test" HeaderText="Test"></local:FolderDialog>
        <GroupBox x:Name="gbFolder" Header="Toolbar folder"  Foreground="Black" BorderBrush="Black" >
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="folder" TextWrapping="WrapWithOverflow"  Text="" BorderBrush="#FF737780" Width="180" />
                <!--<Label x:Name="label" Content="Selected Dir." Grid.Column="0" Grid.Row="0" Margin="0,0,0,0" FontSize="10" VerticalAlignment="Top" Height="18" Width="53" Padding="0,2,0,0" HorizontalContentAlignment="Right" HorizontalAlignment="Left"/>-->
                <Button x:Name="browse" Content="Browse" Width="50" Click="button_Click" Height="20" Margin="5,8,0,0"/>
            </StackPanel>
        </GroupBox>


        <GroupBox x:Name="gbColor" Header="Background Color"  Foreground="Black" BorderBrush="Black" >
            <StackPanel Orientation="Horizontal">
                <Rectangle x:Name="colorRectangle" Width="180" Height="20" Fill="White" MouseLeftButtonDown="colorMouse_Down"  Stroke="Black" Margin="0,0,0,0"/>
                <Button x:Name="selectColor" Content="Select" Width="50" Click="pick_Color" Height="20" Margin="5,5,5,5"/>
            </StackPanel>
        </GroupBox>
        <local:SetBoolProperty x:Name="cntrlAlwaysOnTop"  HeaderText="Alwaysontop" />




        <local:SetBoolProperty x:Name="cntrlOrientationHorizontal"  HeaderText="Horizontal Layout"/>

        <local:SetBoolProperty x:Name="cntrlSecondaryDisplay" HeaderText="Show on secondary display" />
      
        <GroupBox x:Name="opacitry" Header="Opacity" Foreground="Black"  BorderBrush="Black">
            <StackPanel Orientation="Horizontal">

                <Slider x:Name="opacitySlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" HorizontalAlignment="Left" Margin="0,0,0,0" Width="150" LargeChange="5" SmallChange="1" ValueChanged="opacitySlider_ValueChanged"/>
                <Label x:Name="labelOpacity"  Content="0" HorizontalAlignment="Left" Margin="10,0,0,0"  VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="animationType" Foreground="Black" BorderBrush="Black" Header="Animation Type">
            <ListBox x:Name="listBox" d:ItemsSource="{d:SampleData ItemCount=5}"/>


        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button x:Name="cancel"  Width="50px" Grid.Row="4" Content="Cancel" HorizontalAlignment="Right" Height="20" Click="cancel_Click"  Margin="5,5,5,5"/>
            <Button x:Name="ok" Content="Save" Width="34" Click="ok_Click" HorizontalAlignment="Right" Height="20" Margin="0,5,5,5"/>

        </StackPanel>
    

    </StackPanel>
</Window>
